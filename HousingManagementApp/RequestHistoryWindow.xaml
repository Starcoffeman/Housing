<Window x:Class="HousingManagementApp.RequestHistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="История выполнения заявок" 
        Height="650" Width="1100"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#F4E8D3" Padding="10">
            <StackPanel Orientation="Horizontal">
                <Button Content="← Назад" 
                        Click="BackButton_Click"
                        Margin="0,0,20,0"/>
                <TextBlock Text="История выполненных заявок" 
                           FontSize="20" 
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="#F4E8D3" Padding="10" Margin="0,5,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="300"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" 
                           Text="Исполнитель:" 
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>

                <ComboBox x:Name="ExecutorFilterComboBox" 
                         Grid.Column="1" 
                         DisplayMemberPath="OwnerFIO"
                         Margin="0,0,20,0"/>

                <TextBlock Grid.Column="2" 
                           Text="Адрес:" 
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"/>

                <ComboBox x:Name="AddressFilterComboBox" 
                         Grid.Column="3" 
                         DisplayMemberPath="FullAddress"
                         Margin="0,0,20,0"/>

                <Button Grid.Column="4" 
                        Content="🔍 Показать" 
                        Click="FilterButton_Click"
                        Width="100"
                        Margin="0,0,10,0"/>

                <Button Grid.Column="5" 
                        Content="🗑️ Очистить" 
                        Click="ClearFilterButton_Click"
                        Width="100"
                        Background="#FF6B6B"
                        Foreground="White"/>
            </Grid>
        </Border>

        <DataGrid x:Name="HistoryGrid" 
                  Grid.Row="2" 
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  ItemsSource="{Binding}"
                  Margin="10"
                  VerticalScrollBarVisibility="Auto">
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" 
                                  Binding="{Binding RequestId}" 
                                  Width="50"/>
                <DataGridTextColumn Header="Дата" 
                                  Binding="{Binding CreatedDate, StringFormat=dd.MM.yyyy}" 
                                  Width="80"/>
                <DataGridTextColumn Header="Адрес" 
                                  Binding="{Binding FullAddress}" 
                                  Width="200"/>
                <DataGridTextColumn Header="Кв." 
                                  Binding="{Binding FlatNumber}" 
                                  Width="40"/>
                <DataGridTextColumn Header="Заявитель" 
                                  Binding="{Binding ApplicantName}" 
                                  Width="150"/>
                <DataGridTextColumn Header="Телефон" 
                                  Binding="{Binding Phone}" 
                                  Width="100"/>
                <DataGridTextColumn Header="Исполнитель" 
                                  Binding="{Binding ExecutorName}" 
                                  Width="150"/>
                <DataGridTextColumn Header="Статус" 
                                  Binding="{Binding Status}" 
                                  Width="80"/>
                <DataGridTextColumn Header="Начислено" 
                                  Binding="{Binding AccrualAmount, StringFormat=N2}" 
                                  Width="80"/>
                <DataGridTextColumn Header="Оплачено" 
                                  Binding="{Binding PaidAmount, StringFormat=N2}" 
                                  Width="80"/>
                <DataGridTextColumn Header="Баланс" 
                                  Binding="{Binding Balance, StringFormat=N2}" 
                                  Width="80"/>
                <DataGridTextColumn Header="Описание" 
                                  Binding="{Binding ProblemDescription}" 
                                  Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="3" Background="#F4E8D3" Padding="10">
            <TextBlock x:Name="StatusText" 
                       Text="Загрузка истории выполненных заявок..."/>
        </Border>
    </Grid>
</Window>