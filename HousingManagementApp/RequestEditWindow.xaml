<Window x:Class="HousingManagementApp.RequestEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактирование заявки" 
        Height="550" Width="600"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#F4E8D3" Padding="10">
            <TextBlock x:Name="TitleText" 
                       Text="Новая заявка" 
                       FontSize="18" 
                       FontWeight="Bold"/>
        </Border>

        <StackPanel Grid.Row="1" Margin="0,20,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" 
                           Text="Адрес:" 
                           Margin="5" 
                           VerticalAlignment="Center"/>
                <ComboBox x:Name="AddressComboBox" 
                         Grid.Row="0" Grid.Column="1" 
                         Margin="5"
                         DisplayMemberPath="FullAddress"/>

                <TextBlock Grid.Row="1" Grid.Column="0" 
                           Text="Квартира:" 
                           Margin="5" 
                           VerticalAlignment="Center"/>
                <TextBox x:Name="FlatTextBox" 
                        Grid.Row="1" Grid.Column="1" 
                        Margin="5"/>

                <TextBlock Grid.Row="2" Grid.Column="0" 
                           Text="ФИО заявителя:" 
                           Margin="5" 
                           VerticalAlignment="Center"/>
                <TextBox x:Name="ApplicantTextBox" 
                        Grid.Row="2" Grid.Column="1" 
                        Margin="5"/>

                <TextBlock Grid.Row="3" Grid.Column="0" 
                           Text="Телефон:" 
                           Margin="5" 
                           VerticalAlignment="Center"/>
                <TextBox x:Name="PhoneTextBox" 
                        Grid.Row="3" Grid.Column="1" 
                        Margin="5"/>

                <TextBlock Grid.Row="4" Grid.Column="0" 
                           Text="Исполнитель:" 
                           Margin="5" 
                           VerticalAlignment="Center"/>
                <ComboBox x:Name="ExecutorComboBox" 
                         Grid.Row="4" Grid.Column="1" 
                         Margin="5"
                         DisplayMemberPath="OwnerFIO"/>

                <TextBlock Grid.Row="5" Grid.Column="0" 
                           Text="Статус:" 
                           Margin="5" 
                           VerticalAlignment="Center"/>
                <ComboBox x:Name="StatusComboBox" 
                         Grid.Row="5" Grid.Column="1" 
                         Margin="5">
                    <ComboBoxItem Content="Новая" IsSelected="True"/>
                    <ComboBoxItem Content="В работе"/>
                    <ComboBoxItem Content="Выполнена"/>
                    <ComboBoxItem Content="Отменена"/>
                </ComboBox>

                <TextBlock Grid.Row="6" Grid.Column="0" 
                           Text="Описание проблемы:" 
                           Margin="5" 
                           VerticalAlignment="Top"/>
                <TextBox x:Name="ProblemTextBox" 
                        Grid.Row="6" Grid.Column="1" 
                        Margin="5" 
                        Height="100"
                        TextWrapping="Wrap"
                        AcceptsReturn="True"
                        VerticalScrollBarVisibility="Auto"/>
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right"
                    Margin="0,20,0,0">
            <Button Content="💾 Сохранить" 
                    Width="140" 
                    Click="SaveButton_Click"
                    Background="#67BA80"
                    Foreground="White"/>
            <Button Content="❌ Отмена" 
                    Width="100" 
                    Click="CancelButton_Click"
                    Margin="10,0,0,0"/>
        </StackPanel>
    </Grid>
</Window>