<Window x:Class="HousingManagementApp.RequestReportsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Отчеты - Управляющая компания" 
        Height="800" Width="1200"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#F4E8D3" Padding="10">
            <StackPanel Orientation="Horizontal">
                <Button Content="← Назад" 
                        Click="BackButton_Click"
                        Margin="0,0,20,0"/>
                <TextBlock Text="📊 Отчеты и аналитика" 
                           FontSize="20" 
                           FontWeight="Bold"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <TabControl Grid.Row="1" Margin="10">
            <TabItem Header="💰 Финансы">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <Border BorderBrush="#67BA80" BorderThickness="2" CornerRadius="5" Padding="15" Margin="0,0,0,20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="10">
                                    <TextBlock Text="Общая сумма начислений" FontWeight="Bold" Margin="0,0,0,5"/>
                                    <TextBlock x:Name="TotalAccrualText" FontSize="18" Foreground="#0066CC"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="10">
                                    <TextBlock Text="Общая сумма оплат" FontWeight="Bold" Margin="0,0,0,5"/>
                                    <TextBlock x:Name="TotalPaidText" FontSize="18" Foreground="#00AA00"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Margin="10">
                                    <TextBlock Text="Общая задолженность" FontWeight="Bold" Margin="0,0,0,5"/>
                                    <TextBlock x:Name="TotalDebtText" FontSize="18" Foreground="#CC0000"/>
                                </StackPanel>

                                <StackPanel Grid.Column="3" Margin="10">
                                    <TextBlock Text="% оплачено" FontWeight="Bold" Margin="0,0,0,5"/>
                                    <TextBlock x:Name="PaymentPercentText" FontSize="18" Foreground="#FF9900"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock Text="Детализация платежей (последние 20)" FontSize="16" FontWeight="Bold" Margin="0,20,0,10"/>
                        <DataGrid x:Name="PaymentsGrid" 
                                  Height="300"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  Margin="0,0,0,20">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding PaymentID}" Width="50"/>
                                <DataGridTextColumn Header="Собственник" Binding="{Binding OwnerName}" Width="200"/>
                                <DataGridTextColumn Header="Период" Binding="{Binding Period}" Width="100"/>
                                <DataGridTextColumn Header="Начислено" Binding="{Binding Accrual, StringFormat=N2}" Width="100"/>
                                <DataGridTextColumn Header="Оплачено" Binding="{Binding Paid, StringFormat=N2}" Width="100"/>
                                <DataGridTextColumn Header="Статус" Binding="{Binding Status}" Width="100"/>
                                <DataGridTextColumn Header="Адрес" Binding="{Binding Address}" Width="250"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="🏠 Жилищный фонд">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <Border BorderBrush="#67BA80" BorderThickness="2" CornerRadius="5" Padding="15" Margin="0,0,0,20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="10">
                                    <TextBlock Text="Домов в управлении" FontWeight="Bold" Margin="0,0,0,5"/>
                                    <TextBlock x:Name="TotalHousesText" FontSize="18" Foreground="#0066CC"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="10">
                                    <TextBlock Text="Общая площадь" FontWeight="Bold" Margin="0,0,0,5"/>
                                    <TextBlock x:Name="TotalSquareText" FontSize="18" Foreground="#00AA00"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Margin="10">
                                    <TextBlock Text="Всего квартир" FontWeight="Bold" Margin="0,0,0,5"/>
                                    <TextBlock x:Name="TotalFlatsText" FontSize="18" Foreground="#CC0000"/>
                                </StackPanel>

                                <StackPanel Grid.Column="3" Margin="10">
                                    <TextBlock Text="Средний год постройки" FontWeight="Bold" Margin="0,0,0,5"/>
                                    <TextBlock x:Name="AvgYearText" FontSize="18" Foreground="#FF9900"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock Text="Список домов в управлении" FontSize="16" FontWeight="Bold" Margin="0,20,0,10"/>
                        <DataGrid x:Name="HousesGrid" 
                                  Height="300"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Адрес" Binding="{Binding Address}" Width="250"/>
                                <DataGridTextColumn Header="Год" Binding="{Binding Year}" Width="80"/>
                                <DataGridTextColumn Header="Этажей" Binding="{Binding Floors}" Width="70"/>
                                <DataGridTextColumn Header="Квартир" Binding="{Binding Flats}" Width="70"/>
                                <DataGridTextColumn Header="Площадь" Binding="{Binding Square, StringFormat=N1}" Width="80"/>
                                <DataGridTextColumn Header="Управление с" Binding="{Binding ManagementStart, StringFormat=dd.MM.yyyy}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="⚠️ Задолженности">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <Border BorderBrush="#CC0000" BorderThickness="2" CornerRadius="5" Padding="15" Margin="0,0,0,20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="10">
                                    <TextBlock Text="Общая задолженность по воде" FontWeight="Bold" Margin="0,0,0,5"/>
                                    <TextBlock x:Name="TotalWaterDebtText" FontSize="18" Foreground="#0066CC"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="10">
                                    <TextBlock Text="Общая задолженность по электричеству" FontWeight="Bold" Margin="0,0,0,5"/>
                                    <TextBlock x:Name="TotalElectricDebtText" FontSize="18" Foreground="#FF9900"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock Text="ТОП-10 крупнейших задолженностей" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                        <DataGrid x:Name="DebtGrid" 
                                  Height="400"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Собственник" Binding="{Binding OwnerName}" Width="200"/>
                                <DataGridTextColumn Header="Телефон" Binding="{Binding Phone}" Width="120"/>
                                <DataGridTextColumn Header="Адрес" Binding="{Binding Address}" Width="200"/>
                                <DataGridTextColumn Header="Кв." Binding="{Binding Flat}" Width="50"/>
                                <DataGridTextColumn Header="Вода" Binding="{Binding Water, StringFormat=N2}" Width="100"/>
                                <DataGridTextColumn Header="Электричество" Binding="{Binding ElectricPower, StringFormat=N2}" Width="100"/>
                                <DataGridTextColumn Header="Итого" Binding="{Binding Total, StringFormat=N2}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="👥 Собственники">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <Border BorderBrush="#67BA80" BorderThickness="2" CornerRadius="5" Padding="15" Margin="0,0,0,20">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="10">
                                    <TextBlock Text="Всего собственников" FontWeight="Bold" Margin="0,0,0,5"/>
                                    <TextBlock x:Name="TotalOwnersText" FontSize="18" Foreground="#0066CC"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="10">
                                    <TextBlock Text="С контактными телефонами" FontWeight="Bold" Margin="0,0,0,5"/>
                                    <TextBlock x:Name="OwnersWithPhoneText" FontSize="18" Foreground="#00AA00"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <TextBlock Text="Список собственников" FontSize="16" FontWeight="Bold" Margin="0,0,0,10"/>
                        <DataGrid x:Name="OwnersGrid" 
                                  Height="400"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ФИО" Binding="{Binding OwnerFIO}" Width="250"/>
                                <DataGridTextColumn Header="Телефон" Binding="{Binding Phone}" Width="120"/>
                                <DataGridTextColumn Header="Адрес" Binding="{Binding Address}" Width="250"/>
                                <DataGridTextColumn Header="Задолженность" Binding="{Binding TotalDebt, StringFormat=N2}" Width="100"/>
                                <DataGridTextColumn Header="Статус" Binding="{Binding PaymentStatus}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Background="#F4E8D3" Padding="10">
            <TextBlock x:Name="StatusText" Text="Загрузка отчетов..."/>
        </Border>
    </Grid>
</Window>